{
  "name": "dsh-a-upload-plugin",
  "version": "1.0.0",
  "description": "DeepSeek Harness 附件上传插件：在聊天输入框添加附件上传按钮，跨端支持手机相册/文件选择与PC文件上传，自动保存至当前工作区的「文件上传」目录并生成引用标记",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "upload",
    "attachment",
    "mobile"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
